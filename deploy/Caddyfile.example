# 与线上 murmur-new-vps:/etc/caddy/Caddyfile 中 decision 站点块保持一致；改动线上配置后请同步更新本文件。
# 将域名替换为解析到你 VPS 的真实域名（ChatGPT Developer Mode 强制要求公网 HTTPS）。
# 放至 /etc/caddy/Caddyfile 后 `systemctl reload caddy`，Caddy 会自动申请并续期 Let's Encrypt 证书。

decision.yourdomain.com {
    # 不要开启 gzip/zstd encode，保证 SSE 流式输出立即刷新。
    reverse_proxy 127.0.0.1:8789 {
        flush_interval -1
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
        header_down X-Accel-Buffering "no"
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        -Server
    }
}
